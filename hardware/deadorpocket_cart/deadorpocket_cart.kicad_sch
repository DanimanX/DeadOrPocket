(kicad_sch
  (version 20231120)
  (generator "deadorpocket_gen_cart_hardware")
  (generator_version "8.0")
  (uuid "ff0b7843-f184-4ac7-bd0d-1bab8b7dc006")
  (paper "A2")
  (title_block
    (title "DeadOrPocket Compute Cartridge — Sega Model 2 / 2A-CRX")
    (date "2026-11-21")
    (rev "Rev A")
    (company "DanimanX / DeadOrPocket (GPL-3.0)")
    (comment 1 "Target FPGA: Intel Cyclone V 5CEBA5F23C8N (pin-compat 5CEBA7F23C8N) FBGA-484")
    (comment 2 "Memory: 128 MB Dual SDR SDRAM (2x IS42S16320F-6TL) + MicroSD SPI + W25Q64JV ASx4")
    (comment 3 "Power: TPS2552 180mA Slot Limiter + USB-C TPS2116 Priority Mux + 3x TPS62825A Bucks")
    (comment 4 "6-Layer 1.0mm ENIG PCB w/ 32-Pin 3.3V Analogue Pocket Gold Edge Fingers (30 deg chamfer)")
  )
  (lib_symbols)
  (text "SECTION 1: DUAL-SOURCE SAFE POWER TREE\nSlot Pin 1 (+5V_SLOT) -> U7 TPS2552DBVR (R3=150k -> 180mA max) -> U6 TPS2116 IN1\nJ2 USB-C (5.1k Rd CC1/CC2) -> +5V_USBC -> U6 TPS2116 IN2 (Priority Auto-Select)\nU6 VOUT (+5V_SYS) -> U8 TPS62825A (1.10V @ 2A VCCINT)\n                  -> U9 TPS62825A (2.50V @ 0.5A VCC_AUX + FB1 -> VCCA_FPLL)\n                  -> U10 TPS62825A (3.30V @ 1.5A VCCIO / SDRAM / SD / Flash)\nU11 TPS3808G01 (PG monitor + SW1 tactile) -> nCONFIG (A4) & ext_rst_n (A5)" (exclude_from_sim no) (at 30 30 0)
    (effects (font (size 2.2 2.2)) (justify left top))
    (uuid "ed0e4641-533e-452e-908f-ed1187ec42a1")
  )
  (text "SECTION 2: CYCLONE V 5CEBA5F23C8N CONFIG & JTAG (BANK 3A / 9A @ 3.3V)\nMSEL[4:0] = 10010 (ASx4 3.3V): F3=3V3, E5=GND, A2=GND, J6=3V3, L6=GND\nW25Q64JV (U4): DCLK=V3, nCSO=R4, DATA0=AB4, DATA1=AB3, DATA2=AA5, DATA3=T4\nTag-Connect J3 (JTAG): TCK=V5, TMS=P5, TDI=W5, TDO=M5\nControl: nCONFIG=A4 (10k PU), nSTATUS=H5 (10k PU), CONF_DONE=K6 (10k PU), nCE=G5 (GND)\nRef/Power: RREF=A1 (2.00k 1% to GND), VCCBAT=A3 (2.5V), VCCPGM=F8/R19/V8 (3.3V)\nClock: Y1 50.000 MHz TCXO -> H13 (Bank 7A Dedicated Global CLK)" (exclude_from_sim no) (at 30 95 0)
    (effects (font (size 2.2 2.2)) (justify left top))
    (uuid "b5c9bda5-f289-428a-baed-4074e7bd5247")
  )
  (text "SECTION 3: 128 MB DUAL SDR SDRAM (2x IS42S16320F-6TL, ALL BANK 7A @ 3.3V)\nU2 (Lower 64MB): CS# = sdram_cs_n (A13) directly\nU3 (Upper 64MB): CS# = ~sdram_cs_n via U5 SN74LVC1G04DBVR (tpd < 2.5ns)\nShared Bus: CLK=E19 (+180deg, +/-2.5mm matched), CKE=A12, RAS#=A14, CAS#=A15, WE#=B11\nBA[1:0]=B13,B12 | A[12:0]=C11,B22..A17 (A11->DQML, A12->DQMH per m2_sdram DUAL=1)\nDQ[15:0]=E15,E14,E12,D22,D21,D19,D17,D13,D12,C21,C20,C19,C18,C16,C15,C13" (exclude_from_sim no) (at 30 165 0)
    (effects (font (size 2.2 2.2)) (justify left top))
    (uuid "93142900-2034-4acc-a19b-4c2b26bdfca4")
  )
  (text "SECTION 4: 32-PIN ANALOGUE POCKET CARTRIDGE EDGE (BANK 4A + N16 CLK @ 3.3V)\nPin 1=+5V_SLOT | Pin 32=GND | All 30 active signals via RN1-RN8 33 Ohm series arrays\nPin 2 BUS_CLK=N16 (5B CLK) | Pin 3 DIR=P14 | Pin 4 VSYNC=R14 | Pin 5 RST_N=T12 (10k PD)\nPins 6-13  PKT_HDR[7:0]  = V16,V15,V14,V13,U17,U16,U15,U13\nPins 14-21 BUS_DATA[15:8]= AA15,AA14,AA13,Y17,Y16,Y15,Y14,W16\nPins 22-29 BUS_DATA[7:0] = AB21,AB20,AB18,AB17,AA20,AA19,AA18,AA17\nPin 30 POCKET_READY=T13 | Pin 31 CART_VALID=T14 (100k PD to GND)" (exclude_from_sim no) (at 30 235 0)
    (effects (font (size 2.2 2.2)) (justify left top))
    (uuid "2480e8ae-448d-4e5e-9518-578503dbb134")
  )
  (text "SECTION 5: MICROSD SPI BOOT & DIAGNOSTICS (BANK 8A @ 3.3V)\nJ1 Hirose DM3D-SF: SCK=A8, CS#=A9, MOSI=A10, MISO=B10 (47k pull-ups)\nStatus LEDs (330R series): D1 PLL=B5, D2 SDRAM=B6, D3 CPU=B7, D4 BUS_TX=A7" (exclude_from_sim no) (at 30 305 0)
    (effects (font (size 2.2 2.2)) (justify left top))
    (uuid "0149f08b-61c7-492f-babd-ba6c0ad60da0")
  )
