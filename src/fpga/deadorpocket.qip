# DeadOrPocket (Sega Model 2 / 2A-CRX Hybrid Render Core) QIP file list

# APF core wrappers & I2S audio
set_global_assignment -name VERILOG_FILE       [file join $::quartus(qip_path) core/core_top.v]
set_global_assignment -name VERILOG_FILE       [file join $::quartus(qip_path) core/core_bridge_cmd.v]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) core/sound_i2s.sv]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) core/sync_fifo.sv]

# Analogue Pocket platform RTL (DeadOrPocket + SpaceFish PHY)
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) pocket_rtl/m2_pll.sv]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) pocket_rtl/m2_audio_pll.sv]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) pocket_rtl/m2_pk_io.sv]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) pocket_rtl/psram_phy.sv]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) pocket_rtl/m2_fb_psram.sv]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) pocket_rtl/m2_cart_bus.sv]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) pocket_rtl/m2_demo_gen.sv]
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) pocket_rtl/m2_pocket_top.sv]

